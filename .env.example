# Shared Discogs personal access token used by the lookup proxy.
# Set a real value in production (Netlify env, or .env for netlify dev).
RUNOUT_DISCOGS_TOKEN=

# Self-serve email magic-link signup (ADR-0003 S1). All server-only.
# Resend API key for transactional mail. Absent → the mailer no-ops and logs
# the magic-link URL in dev instead of sending (no real email).
RUNOUT_MAIL_API_KEY=
# Optional "From" address for sign-in emails.
RUNOUT_MAIL_FROM=
# Optional canonical public site URL used to build the magic link. Defaults to
# the request origin/host in dev. Set it in production.
RUNOUT_SITE_URL=
# Optional HMAC secret for magic-link tokens. Defaults to RUNOUT_ADMIN_KEY.
# Set a dedicated value in production for key separation.
RUNOUT_MAGIC_LINK_SECRET=
# Optional magic-link TTL in minutes (hard-capped at 30).
RUNOUT_MAGIC_LINK_TTL_MINUTES=

# Self-serve Stripe Checkout (ADR-0003 S3). All server-only — never ship these
# to the SPA, never log them, never put them in any response. The plan ->
# price mapping is server-side so the client never sends an amount.
STRIPE_SECRET_KEY=
# The webhook signing secret (Stripe Dashboard -> Webhooks). billing.js verifies
# the raw body with it (HMAC-SHA256, constant-time) — bad signatures are 400.
STRIPE_WEBHOOK_SECRET=
# Price ids for the two purchasable plans (Stripe Dashboard -> Products).
# STRIPE_PRICE_PREMIUM is a recurring (subscription) price; STRIPE_PRICE_LIFETIME
# is a one-time price.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_LIFETIME=
# Canonical public site URL used for the Checkout success/cancel redirects and
# the Billing Portal return URL (falls back to RUNOUT_SITE_URL, then the request
# origin in dev). Set it in production.
STRIPE_SITE_URL=
