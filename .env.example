# Shared Discogs personal access token used by the lookup proxy.
# Set a real value in production (Netlify env, or .env for netlify dev).
RUNOUT_DISCOGS_TOKEN=

# Self-serve email magic-link signup (ADR-0003 S1). All server-only.
# Resend API key for transactional mail. Absent → the mailer no-ops and logs
# the magic-link URL in dev instead of sending (no real email).
RUNOUT_MAIL_API_KEY=
# Optional "From" address for sign-in emails.
RUNOUT_MAIL_FROM=
# Optional canonical public site URL used to build the magic link. Defaults to
# the request origin/host in dev. Set it in production.
RUNOUT_SITE_URL=
# Optional HMAC secret for magic-link tokens. Defaults to RUNOUT_ADMIN_KEY.
# Set a dedicated value in production for key separation.
RUNOUT_MAGIC_LINK_SECRET=
# Optional magic-link TTL in minutes (hard-capped at 30).
RUNOUT_MAGIC_LINK_TTL_MINUTES=
